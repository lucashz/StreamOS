{
  "name": "streamos",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "corepack pnpm -r --if-present build",
    "dev": "dotenv -e .env -- corepack pnpm -r --parallel --if-present dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "corepack pnpm -r --if-present lint",
    "test": "corepack pnpm -r --if-present test",
    "test:e2e": "corepack pnpm -r --if-present test:e2e",
    "test:e2e:local": "dotenv -e .env -- node tools/e2e-vertical.mjs",
    "test:e2e:accounts": "dotenv -e .env -- node tools/e2e-accounts.mjs",
    "test:e2e:wallet": "dotenv -e .env -- node tools/e2e-wallet.mjs",
    "test:e2e:widgets": "dotenv -e .env -- node tools/e2e-widgets.mjs",
    "test:e2e:songpix": "dotenv -e .env -- node tools/e2e-songpix.mjs",
    "test:e2e:videopix": "dotenv -e .env -- node tools/e2e-videopix.mjs",
    "test:e2e:moderation": "dotenv -e .env -- node tools/e2e-moderation.mjs",
    "test:e2e:campaigns": "dotenv -e .env -- node tools/e2e-campaigns.mjs",
    "test:e2e:subscriptions": "dotenv -e .env -- node tools/e2e-subscriptions.mjs",
    "test:e2e:platform": "dotenv -e .env -- node tools/e2e-platform.mjs",
    "test:e2e:live-control": "dotenv -e .env -- node tools/e2e-live-control.mjs",
    "test:e2e:alert-reliability": "dotenv -e .env -- node tools/e2e-alert-reliability.mjs",
    "test:load:paid-alerts": "dotenv -e .env -- node tools/load-paid-alerts.mjs",
    "test:e2e:alerts": "dotenv -e .env -- node tools/e2e-alert-editor.mjs",
    "test:e2e:browser": "dotenv -e .env -- playwright test",
    "audit:ui": "dotenv -e .env -- node tools/audit-ui.mjs",
    "test:load:beta": "dotenv -e .env -- node tools/load-beta.mjs",
    "test:resilience:beta": "dotenv -e .env -- node tools/resilience-beta.mjs",
    "smoke:staging": "dotenv -e .env -- node tools/smoke-staging.mjs",
    "preflight:staging": "node tools/preflight-staging.mjs",
    "check:woovi:sandbox": "dotenv -e .env -- node tools/check-woovi-sandbox.mjs",
    "typecheck": "corepack pnpm -r --if-present typecheck",
    "db:migrate": "dotenv -e .env -- corepack pnpm --filter @streamos/database db:migrate",
    "db:deploy": "dotenv -e .env -- corepack pnpm --filter @streamos/database db:deploy",
    "db:seed": "dotenv -e .env -- corepack pnpm --filter @streamos/database db:seed",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "local:start": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/start-local.ps1",
    "local:start:fast": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/start-local.ps1 -SkipBuild",
    "local:status": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/status-local.ps1",
    "local:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/stop-local.ps1",
    "local:stop:all": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/stop-local.ps1 -IncludeInfrastructure",
    "tunnel:web": "ngrok http 3000 --url https://bullfight-catlike-rockfish.ngrok-free.dev",
    "tunnel:api": "ngrok http 3001",
    "tunnel:realtime": "ngrok http 3002",
    "tunnel:overlay": "ngrok http 3003",
    "backup:local": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/backup-local.ps1",
    "backup:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/verify-backup-restore.ps1"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@next/eslint-plugin-next": "^15.5.24",
    "@playwright/test": "1.55.1",
    "@types/node": "^24.3.0",
    "dotenv-cli": "^10.0.0",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "socket.io-client": "^4.8.1",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.129.0"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "8.0.2",
      "multer": "2.3.0",
      "postcss": "8.5.28",
      "qs": "6.16.0",
      "sharp": "0.35.4"
    }
  }
}
