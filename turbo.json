{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "API_URL",
    "APP_URL",
    "DATABASE_URL",
    "MAIL_HOST",
    "MAIL_PORT",
    "NODE_ENV",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_REALTIME_URL",
    "OVERLAY_URL",
    "PAYMENT_PROVIDER",
    "REALTIME_URL",
    "REDIS_URL",
    "SESSION_SECRET",
    "WEBHOOK_MOCK_SECRET"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:deploy": {
      "cache": false
    },
    "db:seed": {
      "cache": false
    }
  }
}
