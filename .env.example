NODE_ENV=development
DATABASE_URL=postgresql://streamos:streamos@localhost:55432/streamos
REDIS_URL=redis://localhost:6379
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=/api
INTERNAL_API_URL=http://127.0.0.1:3001
NEXT_PUBLIC_REALTIME_URL=http://localhost:3002
REALTIME_URL=ws://localhost:3002
OVERLAY_URL=http://localhost:3003
SESSION_SECRET=replace-with-a-local-secret-at-least-32-characters
WEBHOOK_MOCK_SECRET=replace-with-a-local-secret-at-least-32-characters
APP_ENCRYPTION_KEY=replace-with-a-separate-secret-at-least-32-characters
# Optional outside local development; protects GET /metrics when configured.
# METRICS_TOKEN=replace-with-a-monitoring-token-at-least-32-characters
STREAMOS_FEE_BPS=500
PSP_FEE_BPS=80
PSP_MINIMUM_FEE_IN_CENTS=50
PSP_MAXIMUM_FEE_IN_CENTS=500
PAYMENTS_ENABLED=true
PAYOUTS_ENABLED=false
VIDEOPIX_ENABLED=true
SONGPIX_ENABLED=true
SUBSCRIPTIONS_ENABLED=true
DAILY_ACCOUNT_LIMIT_IN_CENTS=100000
MAX_LIVE_QUEUE_ITEMS=200
# Alertas imediatos mais antigos que este limite não iniciam ao reconectar o OBS.
MAX_AUTOPLAY_ALERT_AGE_SECONDS=90
MAIL_HOST=localhost
MAIL_PORT=1025
PAYMENT_PROVIDER=mock
# PAYMENT_PROVIDER=woovi
# WOOVI_BASE_URL=https://api.woovi-sandbox.com
# WOOVI_APP_ID=configure-the-woovi-sandbox-app-id
# WOOVI_WEBHOOK_AUTHORIZATION=replace-with-a-random-webhook-secret-at-least-32-characters
# Recommended in production. PEM may use escaped newlines (\\n).
# WOOVI_WEBHOOK_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\\n...\\n-----END PUBLIC KEY-----
# WOOVI_SOURCE_PIX_KEY=source-account-pix-key-for-authorized-pix-out
VIDEO_PROVIDER=mock
# YOUTUBE_API_KEY=configure-me-for-VIDEO_PROVIDER-youtube
SONG_CATALOG_PROVIDER=mock
# SONG_CATALOG_BASE_URL=https://catalog.example.com
# SONG_CATALOG_API_KEY=configure-a-licensed-catalog-provider
SEED_SUPPORT_PASSWORD=StreamOS-Support-Local-123!
ENABLE_MOCK_PAYMENTS=true
