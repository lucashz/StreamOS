{
  "name": "@streamos/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "lint": "eslint .",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:e2e": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "11.4.7",
    "@streamos/config": "workspace:*",
    "@streamos/database": "workspace:*",
    "@streamos/ledger": "workspace:*",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.2",
    "express": "5.1.0",
    "ioredis": "^5.7.0",
    "msedge-tts": "^2.1.0",
    "nodemailer": "^9.1.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/nodemailer": "^7.0.1",
    "tsx": "^4.20.5"
  }
}
